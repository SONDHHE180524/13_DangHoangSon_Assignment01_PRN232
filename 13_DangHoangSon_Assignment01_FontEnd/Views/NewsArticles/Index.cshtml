@model List<_13_DangHoangSon_Assignment01_FontEnd.Models.NewsArticleViewModel>
@{
    ViewData["Title"] = "Quản lý Bài viết Tin tức";
    var categories = ViewBag.Categories as List<_13_DangHoangSon_Assignment01_FontEnd.Models.CategoryViewModel> ?? new();
    var tags = ViewBag.Tags as List<_13_DangHoangSon_Assignment01_FontEnd.Models.TagViewModel> ?? new();
    string currentSearch = ViewBag.CurrentSearch as string ?? "";
    short? currentCategory = ViewBag.CurrentCategory as short?;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-journal-text text-primary me-2"></i>Quản lý Tin tức</h3>
        <p class="text-muted small mb-0">Thêm, sửa, xóa, tìm kiếm bài viết và gán thẻ (Tags) (Dành cho Staff)</p>
    </div>
    <div>
        <!-- Nút mở popup dialog tạo mới -->
        <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#createArticleModal">
            <i class="bi bi-plus-circle me-1"></i> Tạo bài viết mới
        </button>
    </div>
</div>

<!-- Bộ lọc & Tìm kiếm -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Tìm theo tiêu đề, nội dung..." value="@currentSearch" />
                </div>
            </div>
            <div class="col-md-4">
                <select name="categoryId" class="form-select">
                    <option value="">-- Tất cả danh mục --</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.CategoryId" selected="@(currentCategory == c.CategoryId)">@c.CategoryName</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-funnel me-1"></i> Tìm kiếm
                </button>
                @if (!string.IsNullOrEmpty(currentSearch) || currentCategory.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách bài viết -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 100px;">Mã</th>
                        <th>Tiêu đề & Tóm tắt</th>
                        <th>Danh mục</th>
                        <th>Trạng thái</th>
                        <th>Thẻ (Tags)</th>
                        <th>Ngày tạo</th>
                        <th class="text-center" style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-1"></i> Không có bài viết nào
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold text-secondary">@item.NewsArticleId</td>
                                <td>
                                    <div class="fw-bold text-dark">@(item.NewsTitle ?? item.Headline)</div>
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 320px;">@item.Headline</small>
                                </td>
                                <td>
                                    <span class="badge bg-info bg-opacity-10 text-dark">
                                        @(item.Category?.CategoryName ?? "N/A")
                                    </span>
                                </td>
                                <td>
                                    @if (item.NewsStatus == true)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Tags.Any())
                                    {
                                        @foreach (var t in item.Tags)
                                        {
                                            <span class="badge bg-light text-dark border me-1">#@t.TagName</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Không có</span>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @(item.CreatedDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                                </td>
                                <td class="text-center">
                                    <!-- Nút Sửa: mở popup dialog -->
                                    <button class="btn btn-sm btn-outline-primary me-1" onclick="openEditModal('@item.NewsArticleId')" title="Chỉnh sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <!-- Nút Xóa: mở popup xác nhận -->
                                    <button class="btn btn-sm btn-outline-danger" onclick="openDeleteModal('@item.NewsArticleId', '@(item.NewsTitle ?? item.Headline)')" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================= POPUP DIALOG: TẠO MỚI BÀI VIẾT ================= -->
<div class="modal fade" id="createArticleModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold" id="createModalLabel"><i class="bi bi-file-earmark-plus text-primary me-2"></i>Tạo bài viết mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Mã bài viết <span class="text-danger">*</span></label>
                            <input name="NewsArticleId" class="form-control" placeholder="VD: NEWS01" required maxlength="20" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Danh mục <span class="text-danger">*</span></label>
                            <select name="CategoryId" class="form-select" required>
                                <option value="">-- Chọn danh mục --</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.CategoryId">@c.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Tiêu đề bài viết</label>
                            <input name="NewsTitle" class="form-control" placeholder="Tiêu đề chính thức của bài viết" maxlength="400" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Tiêu đề phụ (Headline) <span class="text-danger">*</span></label>
                            <input name="Headline" class="form-control" placeholder="Tóm tắt ngắn gọn hoặc tiêu đề phụ" required maxlength="150" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Nội dung chi tiết</label>
                            <textarea name="NewsContent" class="form-control" rows="5" placeholder="Nội dung bài viết..." maxlength="4000"></textarea>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Nguồn tin (News Source)</label>
                            <input name="NewsSource" class="form-control" placeholder="VD: Phòng Đào tạo / Báo Tuổi Trẻ" maxlength="400" />
                        </div>
                        <div class="col-md-4 d-flex align-items-center mt-4">
                            <div class="form-check form-switch fs-5">
                                <input class="form-check-input" type="checkbox" name="NewsStatus" value="true" checked id="createNewsStatus" />
                                <label class="form-check-label fs-6 fw-semibold" for="createNewsStatus">Kích hoạt (Active)</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Gắn thẻ (Tags)</label>
                            <div class="p-3 bg-light rounded border d-flex flex-wrap gap-3">
                                @foreach (var t in tags)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="TagIds" value="@t.TagId" id="createTag_@t.TagId" />
                                        <label class="form-check-label small" for="createTag_@t.TagId">@t.TagName</label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Lưu bài viết</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= POPUP DIALOG: CẬP NHẬT BÀI VIẾT ================= -->
<div class="modal fade" id="editArticleModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form id="editArticleForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold" id="editModalLabel"><i class="bi bi-pencil-square text-primary me-2"></i>Cập nhật bài viết</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Mã bài viết</label>
                            <input id="editArticleId" name="NewsArticleId" class="form-control bg-light" readonly />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Danh mục <span class="text-danger">*</span></label>
                            <select id="editCategoryId" name="CategoryId" class="form-select" required>
                                <option value="">-- Chọn danh mục --</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.CategoryId">@c.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Tiêu đề bài viết</label>
                            <input id="editNewsTitle" name="NewsTitle" class="form-control" maxlength="400" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Tiêu đề phụ (Headline) <span class="text-danger">*</span></label>
                            <input id="editHeadline" name="Headline" class="form-control" required maxlength="150" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Nội dung chi tiết</label>
                            <textarea id="editNewsContent" name="NewsContent" class="form-control" rows="5" maxlength="4000"></textarea>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Nguồn tin (News Source)</label>
                            <input id="editNewsSource" name="NewsSource" class="form-control" maxlength="400" />
                        </div>
                        <div class="col-md-4 d-flex align-items-center mt-4">
                            <div class="form-check form-switch fs-5">
                                <input class="form-check-input" type="checkbox" name="NewsStatus" value="true" id="editNewsStatus" />
                                <label class="form-check-label fs-6 fw-semibold" for="editNewsStatus">Kích hoạt (Active)</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Gắn thẻ (Tags)</label>
                            <div class="p-3 bg-light rounded border d-flex flex-wrap gap-3">
                                @foreach (var t in tags)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input edit-tag-check" type="checkbox" name="TagIds" value="@t.TagId" id="editTag_@t.TagId" />
                                        <label class="form-check-label small" for="editTag_@t.TagId">@t.TagName</label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Cập nhật thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= POPUP DIALOG: XÁC NHẬN XÓA BÀI VIẾT ================= -->
<div class="modal fade" id="deleteArticleModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="deleteArticleForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold text-danger" id="deleteModalLabel"><i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa bài viết</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <p class="fs-5 mb-2">Bạn có chắc chắn muốn xóa bài viết này?</p>
                    <div class="alert alert-light border fw-semibold text-danger" id="deleteArticleName"></div>
                    <p class="text-muted small mb-0">Hành động này sẽ xóa vĩnh viễn bài viết khỏi hệ thống.</p>
                </div>
                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Xác nhận Xóa</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditModal(articleId) {
            fetch(`/NewsArticles/Get?id=${articleId}`)
                .then(res => {
                    if (!res.ok) throw new Error("Không thể tải thông tin bài viết");
                    return res.json();
                })
                .then(data => {
                    const dto = data.dto;
                    $('#editArticleId').val(dto.newsArticleId);
                    $('#editNewsTitle').val(dto.newsTitle || '');
                    $('#editHeadline').val(dto.headline || '');
                    $('#editNewsContent').val(dto.newsContent || '');
                    $('#editNewsSource').val(dto.newsSource || '');
                    $('#editCategoryId').val(dto.categoryId);
                    $('#editNewsStatus').prop('checked', dto.newsStatus === true);

                    // Đặt action URL cho form edit
                    $('#editArticleForm').attr('action', `/NewsArticles/Edit?id=${dto.newsArticleId}`);

                    // Reset và check các tags
                    $('.edit-tag-check').prop('checked', false);
                    if (dto.tagIds && dto.tagIds.length > 0) {
                        dto.tagIds.forEach(tId => {
                            $(`#editTag_${tId}`).prop('checked', true);
                        });
                    }

                    const modal = new bootstrap.Modal(document.getElementById('editArticleModal'));
                    modal.show();
                })
                .catch(err => {
                    alert("Lỗi: " + err);
                });
        }

        function openDeleteModal(articleId, articleTitle) {
            $('#deleteArticleName').text(articleTitle + ` (Mã: ${articleId})`);
            $('#deleteArticleForm').attr('action', `/NewsArticles/Delete?id=${articleId}`);
            const modal = new bootstrap.Modal(document.getElementById('deleteArticleModal'));
            modal.show();
        }
    </script>
}
