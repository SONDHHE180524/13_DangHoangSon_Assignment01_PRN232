@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    var userId = session?.GetInt32("UserId");
    var userName = session?.GetString("UserName");
    var userEmail = session?.GetString("UserEmail");
    var userRole = session?.GetInt32("UserRole");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FU News Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: #f8f9fa;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-brand {
            font-weight: 700;
            color: #0d6efd !important;
            letter-spacing: 0.5px;
        }
        .nav-link.active {
            font-weight: 600;
            color: #0d6efd !important;
        }
        .card {
            border: none;
            border-radius: 0.75rem;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }
        .card-header {
            background-color: transparent;
            border-bottom: 1px solid rgba(0,0,0,0.075);
            font-weight: 600;
        }
        .btn {
            border-radius: 0.5rem;
            font-weight: 500;
        }
        .modal-content {
            border-radius: 0.75rem;
            border: none;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }
        .badge {
            font-weight: 500;
            padding: 0.4em 0.7em;
            border-radius: 0.35rem;
        }
        main {
            flex: 1 0 auto;
        }
        footer {
            flex-shrink: 0;
            background-color: #fff;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-newspaper fs-4 me-2 text-primary"></i>
                    <span>FUNews Management</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <!-- Trang tin tức công khai cho mọi người -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Trang chủ tin tức
                            </a>
                        </li>

                        @if (userRole.HasValue && userRole.Value == 0)
                        {
                            <!-- Menu dành cho Admin -->
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Accounts" asp-action="Index">
                                    <i class="bi bi-people me-1"></i> Quản lý Tài khoản
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reports" asp-action="Index">
                                    <i class="bi bi-bar-chart-line me-1"></i> Báo cáo Thống kê
                                </a>
                            </li>
                        }
                        else if (userRole.HasValue && userRole.Value == 1)
                        {
                            <!-- Menu dành cho Staff -->
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="NewsArticles" asp-action="Index">
                                    <i class="bi bi-journal-text me-1"></i> Quản lý Tin tức
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Categories" asp-action="Index">
                                    <i class="bi bi-folder2-open me-1"></i> Quản lý Danh mục
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="NewsArticles" asp-action="History">
                                    <i class="bi bi-clock-history me-1"></i> Lịch sử viết bài
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (userId.HasValue)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="badge @(userRole == 0 ? "bg-danger" : userRole == 1 ? "bg-success" : "bg-info") me-2">
                                        @(userRole == 0 ? "Admin" : userRole == 1 ? "Staff" : "Lecturer")
                                    </span>
                                    <span class="fw-semibold text-dark me-1">@userName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userDropdown">
                                    <li class="dropdown-item-text text-muted small">
                                        <i class="bi bi-envelope me-1"></i> @userEmail
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    @if (userRole == 1 || userRole == 2)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Profile" asp-action="Index">
                                                <i class="bi bi-person me-2 text-primary"></i> Hồ sơ cá nhân
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary px-3 py-1" asp-controller="Auth" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        <!-- Thông báo Toast / Alert -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top py-3 text-muted text-center small mt-auto">
        <div class="container">
            &copy; 2026 - FU News Management System (PRN232 Assignment 01)
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
