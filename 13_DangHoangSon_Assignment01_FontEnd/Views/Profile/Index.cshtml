@model _13_DangHoangSon_Assignment01_FontEnd.Models.UserProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h4 class="fw-bold mb-0 text-primary">
                    <i class="bi bi-person-bounding-box me-2"></i>Hồ sơ cá nhân
                </h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Index" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="AccountId" />
                    <input type="hidden" asp-for="AccountRole" />

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mã tài khoản (ID)</label>
                        <input class="form-control bg-light" value="@Model.AccountId" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="AccountName" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
                            <input asp-for="AccountName" class="form-control" />
                        </div>
                        <span asp-validation-for="AccountName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AccountEmail" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-envelope"></i></span>
                            <input asp-for="AccountEmail" class="form-control" />
                        </div>
                        <span asp-validation-for="AccountEmail" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AccountPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-key"></i></span>
                            <input asp-for="AccountPassword" class="form-control" />
                        </div>
                        <span asp-validation-for="AccountPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Vai trò hiện tại</label>
                        <div>
                            <span class="badge bg-success p-2">
                                <i class="bi bi-shield-check me-1"></i>@(Model.AccountRole == 1 ? "Staff" : Model.AccountRole == 2 ? "Lecturer" : "Admin")
                            </span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Quay lại</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i> Lưu thông tin
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
