@model List<_13_DangHoangSon_Assignment01_FontEnd.Models.SystemAccountViewModel>
@{
    ViewData["Title"] = "Quản lý Tài khoản";
    string currentSearch = ViewBag.CurrentSearch as string ?? "";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-people text-primary me-2"></i>Quản lý Tài khoản</h3>
        <p class="text-muted small mb-0">Thêm, sửa, xóa, tìm kiếm tài khoản người dùng trong hệ thống (Dành cho Admin)</p>
    </div>
    <div>
        <!-- Nút mở popup dialog tạo tài khoản mới -->
        <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#createAccountModal">
            <i class="bi bi-person-plus me-1"></i> Tạo tài khoản mới
        </button>
    </div>
</div>

<!-- Thanh tìm kiếm -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Tìm theo họ tên, email..." value="@currentSearch" />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-funnel me-1"></i> Tìm kiếm
                </button>
                @if (!string.IsNullOrEmpty(currentSearch))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách tài khoản -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Vai trò (Role)</th>
                        <th>Mật khẩu</th>
                        <th class="text-center" style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-1"></i> Không tìm thấy tài khoản nào
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold text-secondary">@item.AccountId</td>
                                <td class="fw-bold text-dark">@item.AccountName</td>
                                <td>@item.AccountEmail</td>
                                <td>
                                    @if (item.AccountRole == 1)
                                    {
                                        <span class="badge bg-success">Staff (1)</span>
                                    }
                                    else if (item.AccountRole == 2)
                                    {
                                        <span class="badge bg-info text-dark">Lecturer (2)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Khác (@item.AccountRole)</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-muted font-monospace">••••••</span>
                                </td>
                                <td class="text-center">
                                    <!-- Nút Sửa: mở popup dialog -->
                                    <button class="btn btn-sm btn-outline-primary me-1" onclick="openEditAccountModal(@item.AccountId)" title="Chỉnh sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <!-- Nút Xóa: mở popup xác nhận -->
                                    <button class="btn btn-sm btn-outline-danger" onclick="openDeleteAccountModal(@item.AccountId, '@item.AccountName')" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================= POPUP DIALOG: TẠO MỚI TÀI KHOẢN ================= -->
<div class="modal fade" id="createAccountModal" tabindex="-1" aria-labelledby="createAccModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold" id="createAccModalLabel"><i class="bi bi-person-plus text-primary me-2"></i>Tạo tài khoản mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                        <input name="AccountName" class="form-control" placeholder="Nguyễn Văn A..." required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                        <input name="AccountEmail" type="email" class="form-control" placeholder="example@FUNewsManagement.org" required maxlength="70" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Vai trò <span class="text-danger">*</span></label>
                        <select name="AccountRole" class="form-select" required>
                            <option value="1">Staff (1) - Quản trị tin tức & danh mục</option>
                            <option value="2">Lecturer (2) - Giảng viên đọc tin</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
                        <input name="AccountPassword" class="form-control" placeholder="Nhập mật khẩu..." required maxlength="70" />
                    </div>
                </div>
                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Tạo tài khoản</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= POPUP DIALOG: CẬP NHẬT TÀI KHOẢN ================= -->
<div class="modal fade" id="editAccountModal" tabindex="-1" aria-labelledby="editAccModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="editAccountForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold" id="editAccModalLabel"><i class="bi bi-pencil-square text-primary me-2"></i>Cập nhật tài khoản</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" id="editAccId" name="AccountId" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                        <input id="editAccName" name="AccountName" class="form-control" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                        <input id="editAccEmail" name="AccountEmail" type="email" class="form-control" required maxlength="70" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Vai trò <span class="text-danger">*</span></label>
                        <select id="editAccRole" name="AccountRole" class="form-select" required>
                            <option value="1">Staff (1)</option>
                            <option value="2">Lecturer (2)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mật khẩu <span class="text-danger">*</span></label>
                        <input id="editAccPassword" name="AccountPassword" class="form-control" required maxlength="70" />
                    </div>
                </div>
                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= POPUP DIALOG: XÁC NHẬN XÓA TÀI KHOẢN ================= -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="deleteAccountForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold text-danger" id="deleteAccModalLabel"><i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa tài khoản</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <p class="fs-5 mb-2">Bạn có chắc chắn muốn xóa tài khoản này?</p>
                    <div class="alert alert-light border fw-semibold text-danger" id="deleteAccountName"></div>
                    <p class="text-muted small mb-0">
                        <i class="bi bi-info-circle me-1"></i> Lưu ý: Tài khoản đã từng khởi tạo bài viết tin tức sẽ <strong>không được phép xóa</strong> theo quy định!
                    </p>
                </div>
                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Xác nhận Xóa</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditAccountModal(accId) {
            fetch(`/Accounts/Get?id=${accId}`)
                .then(res => {
                    if (!res.ok) throw new Error("Không thể tải thông tin tài khoản");
                    return res.json();
                })
                .then(acc => {
                    $('#editAccId').val(acc.accountId);
                    $('#editAccName').val(acc.accountName);
                    $('#editAccEmail').val(acc.accountEmail);
                    $('#editAccRole').val(acc.accountRole);
                    $('#editAccPassword').val(acc.accountPassword);

                    $('#editAccountForm').attr('action', `/Accounts/Edit?id=${acc.accountId}`);

                    const modal = new bootstrap.Modal(document.getElementById('editAccountModal'));
                    modal.show();
                })
                .catch(err => {
                    alert("Lỗi: " + err);
                });
        }

        function openDeleteAccountModal(accId, accName) {
            $('#deleteAccountName').text(`${accName} (ID: ${accId})`);
            $('#deleteAccountForm').attr('action', `/Accounts/Delete?id=${accId}`);
            const modal = new bootstrap.Modal(document.getElementById('deleteAccountModal'));
            modal.show();
        }
    </script>
}
